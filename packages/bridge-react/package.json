{
  "name": "@selenus/kit-bridge-react",
  "version": "0.1.0",
  "description": "React hooks bridging wallet-adapter-react to @solana/kit signers. Zero UI, pure logic.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@selenus/kit-bridge-core": "workspace:*",
    "@solana/compat": "^6.5.0"
  },
  "peerDependencies": {
    "@solana/kit": ">=6.5.0",
    "@solana/wallet-adapter-base": ">=0.9.0",
    "@solana/wallet-adapter-react": ">=0.15.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@solana/kit": "^6.5.0",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.37",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "rimraf": "^6.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
