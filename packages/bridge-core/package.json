{
  "name": "@selenus/kit-bridge-core",
  "version": "0.1.0",
  "description": "Core wallet bridge logic — create Kit-compatible signers from wallet-adapter wallets.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@solana/compat": "^6.5.0",
    "@solana/kit": "^6.5.0"
  },
  "peerDependencies": {
    "@solana/wallet-adapter-base": ">=0.9.0",
    "@solana/web3.js": ">=1.90.0"
  },
  "peerDependenciesMeta": {
    "@solana/wallet-adapter-base": { "optional": false },
    "@solana/web3.js": { "optional": false }
  },
  "devDependencies": {
    "@selenus/test-wallet-mocks": "workspace:*",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/web3.js": "^1.98.4",
    "rimraf": "^6.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
